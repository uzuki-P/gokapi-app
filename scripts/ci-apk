#!/usr/bin/env bash
# Wait for the android-apk GitHub Actions build of the pushed HEAD, save the
# APK in _apk/, delete the GitHub artifact, and share the APK via Gokapi; the
# share link prints last. Reuses the build the push started; dispatches one
# when there is none, for example after a docs-only push.
set -euo pipefail

workflow=android-apk.yml

git fetch --quiet origin
head=$(git rev-parse HEAD)
branch=$(git branch --show-current)
if [[ "$head" != "$(git rev-parse "origin/$branch")" ]]; then
  echo "HEAD is not pushed to origin/$branch; push first so CI builds this commit." >&2
  exit 1
fi

# Newest run for this commit that is still going or succeeded.
find_run() {
  gh run list --workflow "$workflow" --commit "$head" --limit 5 --json databaseId,status,conclusion \
    --jq '[.[] | select(.status != "completed" or .conclusion == "success")][0].databaseId // empty'
}

run_id=$(find_run)
if [[ -z "$run_id" ]]; then
  gh workflow run "$workflow" --ref "$branch"
  for _ in $(seq 30); do
    run_id=$(find_run)
    [[ -n "$run_id" ]] && break
    sleep 2
  done
  [[ -n "$run_id" ]] || { echo "Workflow run did not appear." >&2; exit 1; }
fi

gh run watch "$run_id" --exit-status

out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
gh run download "$run_id" --dir "$out"
mkdir -p _apk
apk=""
while IFS= read -r -d '' file; do
  apk="_apk/$(basename "$file")"
  cp "$file" "$apk"
  echo "Saved: $apk"
done < <(find "$out" -type f -name '*.apk' -print0)
[[ -n "$apk" ]] || { echo "Run $run_id has no APK artifact." >&2; exit 1; }

# The local copy is the keeper; drop the GitHub artifact so it stops using
# Actions storage.
for id in $(gh api "repos/{owner}/{repo}/actions/runs/$run_id/artifacts" --jq '.artifacts[].id'); do
  gh api --silent -X DELETE "repos/{owner}/{repo}/actions/artifacts/$id"
done

~/docker/files/bin/share "$(pwd)/$apk"
